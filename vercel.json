{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemaps/sitemap.xml"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/sitemaps/sitemap-index.xml"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/sitemaps/sitemap-pages.xml"
    },
    {
      "source": "/sitemap-projects.xml",
      "destination": "/sitemaps/sitemap-projects.xml"
    },
    {
      "source": "/gtag/js",
      "destination": "https://www.googletagmanager.com/gtag/js"
    },
    {
      "source": "/gtm.js",
      "destination": "https://www.googletagmanager.com/gtm.js"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/why-me",
      "destination": "/why-me/index.html"
    },
    {
      "source": "/professional",
      "destination": "/professional/index.html"
    },
    {
      "source": "/personal",
      "destination": "/personal/index.html"
    },
    {
      "source": "/side-projects",
      "destination": "/side-projects/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'sha256-Q2CGEB/e7iGOYWP3yA4MLUeqGWXLLrtJgrBN0bGK/Lo=' 'strict-dynamic' 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://www.googletagmanager.com https://challenges.cloudflare.com; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self'; manifest-src 'self'; require-trusted-types-for 'script'; trusted-types bootstrap default goog#html 'allow-duplicates'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "Content-Signal",
          "value": "ai-train=no, search=yes, ai-input=yes"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
