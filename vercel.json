{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rodrigoai-personal.vercel.app"
        }
      ],
      "destination": "https://www.rpovoadata.tech/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/gtag/js",
      "destination": "https://www.googletagmanager.com/gtag/js"
    },
    {
      "source": "/gtm.js",
      "destination": "https://www.googletagmanager.com/gtm.js"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/why-me",
      "destination": "/why-me/index.html"
    },
    {
      "source": "/professional",
      "destination": "/professional/index.html"
    },
    {
      "source": "/personal",
      "destination": "/personal/index.html"
    },
    {
      "source": "/side-projects",
      "destination": "/side-projects/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'sha256-w8lKegi+cjQCjAvJxjiPZESOC+MJyHo9wpU6xITyT2E=' 'strict-dynamic' 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://www.googletagmanager.com https://challenges.cloudflare.com; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self'; manifest-src 'self'; require-trusted-types-for 'script'; trusted-types bootstrap default goog#html 'allow-duplicates'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "Content-Signal",
          "value": "ai-train=no, search=yes, ai-input=yes"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/agent.json>; rel=\"service-desc\"; type=\"application/json\", </sitemaps/sitemap-index.xml>; rel=\"sitemap\"; type=\"application/xml\""
        },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/:page(why-me|professional|personal|side-projects|blog|privacy|contact)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/blog/:slug",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/agent.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
